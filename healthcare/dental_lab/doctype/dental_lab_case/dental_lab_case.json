{
 "doctype": "DocType",
 "name": "Dental Lab Case",
 "module": "Dental Lab",
 "engine": "InnoDB",
 "autoname": "DLC-.YYYY.-.#####",
 "allow_rename": 0,
 "is_submittable": 0,
 "restrict_to_domain": "Healthcare",
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "actions": [],
 "links": [],
 "states": [],
 "field_order": [
  "overview_section",
  "case_origin",
  "priority",
  "overview_column",
  "status",
  "organisation_section",
  "company",
  "production_branch",
  "organisation_column",
  "origin_branch",
  "warehouse",
  "partner_section",
  "customer",
  "patient",
  "partner_column",
  "external_reference",
  "practitioner",
  "patient_appointment",
  "patient_encounter",
  "clinical_links_section",
  "service_request",
  "lab_test",
  "clinical_links_column",
  "diagnostic_report",
  "schedule_section",
  "received_on",
  "schedule_column",
  "due_date",
  "items_section",
  "items",
  "commercial_section",
  "sales_order",
  "notes_section",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "overview_section",
   "fieldtype": "Section Break",
   "label": "Case Overview"
  },
  {
   "fieldname": "case_origin",
   "fieldtype": "Select",
   "label": "Case Origin",
   "options": "\nInternal Clinic\nExternal Clinic",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "read_only_depends_on": "eval:!doc.__islocal && doc.status!=='Received'"
  },
  {
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "Priority",
   "options": "Normal\nUrgent",
   "default": "Normal",
   "in_list_view": 1,
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "overview_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Received\nIn Production\nQuality Check\nReady for Delivery\nDelivered\nCancelled",
   "default": "Received",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "read_only_depends_on": "eval:!!doc.__islocal || doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "organisation_section",
   "fieldtype": "Section Break",
   "label": "Organization & Branch"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_standard_filter": 1,
   "read_only_depends_on": "eval:!doc.__islocal && doc.status!=='Received'"
  },
  {
   "fieldname": "production_branch",
   "fieldtype": "Link",
   "label": "Production Branch",
   "options": "Branch",
   "reqd": 1,
   "in_standard_filter": 1,
   "depends_on": "eval:!!doc.company",
   "read_only_depends_on": "eval:!doc.__islocal && doc.status!=='Received'"
  },
  {
   "fieldname": "organisation_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "origin_branch",
   "fieldtype": "Link",
   "label": "Originating Clinic Branch",
   "options": "Branch",
   "depends_on": "eval:doc.case_origin==='Internal Clinic'",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "warehouse",
   "fieldtype": "Link",
   "label": "Lab Warehouse",
   "options": "Warehouse",
   "depends_on": "eval:!!doc.company",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "partner_section",
   "fieldtype": "Section Break",
   "label": "Customer & Clinical Reference"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer (External Clinic)",
   "options": "Customer",
   "mandatory_depends_on": "eval:doc.case_origin==='External Clinic'",
   "in_standard_filter": 1,
   "depends_on": "eval:doc.case_origin==='External Clinic'",
   "read_only_depends_on": "eval:!doc.__islocal && doc.status!=='Received'"
  },
  {
   "fieldname": "patient",
   "fieldtype": "Link",
   "label": "Patient (Internal Clinic)",
   "options": "Patient",
   "mandatory_depends_on": "eval:doc.case_origin==='Internal Clinic'",
   "depends_on": "eval:doc.case_origin==='Internal Clinic'",
   "read_only_depends_on": "eval:!doc.__islocal && doc.status!=='Received'"
  },
  {
   "fieldname": "partner_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "external_reference",
   "fieldtype": "Data",
   "label": "External Clinic Case ID",
   "depends_on": "eval:doc.case_origin==='External Clinic'",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "practitioner",
   "fieldtype": "Link",
   "label": "Referring Practitioner",
   "options": "Healthcare Practitioner",
   "depends_on": "eval:!!doc.case_origin",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "patient_appointment",
   "fieldtype": "Link",
   "label": "Patient Appointment",
   "options": "Patient Appointment",
   "depends_on": "eval:doc.case_origin==='Internal Clinic' && !!doc.patient",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "patient_encounter",
   "fieldtype": "Link",
   "label": "Patient Encounter",
   "options": "Patient Encounter",
   "depends_on": "eval:doc.case_origin==='Internal Clinic' && !!doc.patient",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "clinical_links_section",
   "label": "Clinical Diagnostics (Internal Clinic)",
   "fieldtype": "Section Break",
   "depends_on": "eval:doc.case_origin==='Internal Clinic'"
  },
  {
   "fieldname": "service_request",
   "label": "Service Request",
   "fieldtype": "Link",
   "options": "Service Request",
   "depends_on": "eval:doc.case_origin==='Internal Clinic' && !!doc.patient"
  },
  {
   "fieldname": "lab_test",
   "label": "Lab Test",
   "fieldtype": "Link",
   "options": "Lab Test",
   "depends_on": "eval:doc.case_origin==='Internal Clinic' && !!doc.patient"
  },
  {
   "fieldname": "clinical_links_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "diagnostic_report",
   "label": "Diagnostic Report",
   "fieldtype": "Link",
   "options": "Diagnostic Report",
   "depends_on": "eval:doc.case_origin==='Internal Clinic' && !!doc.patient"
  },
  {
   "fieldname": "schedule_section",
   "fieldtype": "Section Break",
   "label": "Schedule"
  },
  {
   "fieldname": "received_on",
   "fieldtype": "Date",
   "label": "Received On",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1,
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "schedule_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "due_date",
   "fieldtype": "Date",
   "label": "Promised Delivery Date",
   "in_list_view": 1,
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "items_section",
   "fieldtype": "Section Break",
   "label": "Dental Work Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Case Items",
   "options": "Dental Lab Case Item",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "commercial_section",
   "fieldtype": "Section Break",
   "label": "Commercial Reference",
   "depends_on": "eval:doc.case_origin==='External Clinic' && !!doc.customer"
  },
  {
   "fieldname": "sales_order",
   "fieldtype": "Link",
   "label": "Sales Order",
   "options": "Sales Order",
   "depends_on": "eval:doc.case_origin==='External Clinic' && !!doc.customer",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  },
  {
   "fieldname": "notes_section",
   "fieldtype": "Section Break",
   "label": "Internal Lab Notes"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Case Instructions",
   "read_only_depends_on": "eval:doc.status==='Delivered' || doc.status==='Cancelled'"
  }
 ],
 "search_fields": "case_origin,customer,patient,external_reference,production_branch,status",
 "permissions": [
  {
   "role": "Healthcare Administrator",
   "read": 1,
   "create": 1,
   "write": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  }
 ]
}
